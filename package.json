{
	"name": "obsidian-marginalia",
	"version": "1.0.5",
	"description": "Non-destructive annotation plugin for Obsidian",
	"main": "main.js",
	"type": "module",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"check:encoding": "node scripts/check-encoding.mjs",
		"build": "npm run check:encoding && tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
		"version": "node version-bump.mjs && git add manifest.json versions.json main.js styles.css",
		"lint": "eslint .",
		"test": "npm run test:unit",
		"test:unit": "vitest run",
		"test:unit:watch": "vitest",
		"deploy:local": "npm run build && node scripts/deploy-local-plugin.mjs",
		"test:e2e": "npm run deploy:local && node scripts/e2e-local-obsidian.mjs",
		"test:e2e:tablet": "npm run deploy:local && node scripts/e2e-local-obsidian-tablet.mjs",
		"test:all": "npm run test:unit && npm run test:e2e"
	},
	"keywords": [],
	"license": "0-BSD",
	"devDependencies": {
		"@types/node": "^20.12.12",
		"esbuild": "0.25.5",
		"eslint-plugin-obsidianmd": "0.1.9",
		"globals": "14.0.0",
		"tslib": "2.4.0",
		"typescript": "^5.8.3",
		"typescript-eslint": "8.35.1",
		"@eslint/js": "9.30.1",
		"jiti": "2.6.1",
		"playwright-core": "^1.56.1",
		"vitest": "^3.2.4"
	},
	"dependencies": {
		"obsidian": "latest"
	}
}
